package ch.qos.logback.core.joran.util;

import ch.qos.logback.core.Context;
import ch.qos.logback.core.StatusManager;
import ch.qos.logback.core.spi.ContextAwareBase;
import ch.qos.logback.core.util.AggregationType;
import ch.qos.logback.core.util.PropertySetterException;
import ch.qos.logback.core.joran.util.beans.BeanDescriptionCache;
import ch.qos.logback.core.joran.spi.DefaultNestedComponentRegistry;
import org.junit.Before;
import org.junit.Test;

import java.util.*;
import java.util.concurrent.*;

import static org.junit.Assert.*;

/**
 * JUnit‑4 test suite for {@link PropertySetter}.
 *
 * The tests cover:
 * <ul>
 *   <li>public API methods (basic functionality)</li>
 *   <li>edge cases such as null values, missing setters/adders and type mismatches</li>
 *   <li>exception handling paths (conversion failures, illegal arguments)</li>
 * </ul>
 *
 * A very small {@link TestBean} is used as the target object.  It contains
 * simple JavaBean setters, an adder for a collection property and a complex
 * property ( {@link SubBean}) to exercise the “complex” handling paths.
 *
 * The {@link SimpleContext} implements {@link Context} with no‑op methods – it
 * is only required because {@link BeanDescriptionCache} needs a {@code Context}
 * instance.  No real logging / status handling is verified; the tests merely
 * ensure that no unchecked exceptions escape from the {@code PropertySetter}
 * methods.
 */
public class PropertySetterTest {

    /* --------------------------------------------------------------------- */
    /*  Helper classes used only by the tests                               */
    /* --------------------------------------------------------------------- */

    /** Minimal {@link Context} implementation – all methods are no‑ops. */
    private static class SimpleContext implements Context {
        @Override public StatusManager getStatusManager() { return null; }
        @Override public Object getObject(String key) { return null; }
        @Override public void putObject(String key, Object value) {}
        @Override public String getProperty(String key) { return null; }
        @Override public void putProperty(String key, String value) {}
        @Override public Map<String, String> getCopyOfPropertyMap() { return Collections.emptyMap(); }
        @Override public String getName() { return null; }
        @Override public void setName(String name) {}
        @Override public long getBirthTime() { return 0L; }
        @Override public Object getConfigurationLock() { return null; }
        @Override public ScheduledExecutorService getScheduledExecutorService() { return null; }
        @Override public ExecutorService getExecutorService() { return null; }
        @Override public ExecutorService getAlternateExecutorService() { return null; }
        @Override public void register(ch.qos.logback.core.spi.LifeCycle component) {}
        @Override public void addScheduledFuture(ScheduledFuture<?> scheduledFuture) {}
        @Override public ch.qos.logback.core.util.SequenceNumberGenerator getSequenceNumberGenerator() { return null; }
        @Override public void setSequenceNumberGenerator(ch.qos.logback.core.util.SequenceNumberGenerator sequenceNumberGenerator) {}
        @Override public void addConfigurationEventListener(ch.qos.logback.core.joran.spi.ConfigurationEventListener listener) {}
        @Override public void fireConfigurationEvent(ch.qos.logback.core.joran.spi.ConfigurationEvent configurationEvent) {}
    }

    /** Simple bean with a few properties used by the tests. */
    public static class TestBean {
        private String name;
        private int age;
        private boolean active;
        private SubBean subBean;
        private final List<String> items = new ArrayList<>();

        /* ----- JavaBean setters ----- */
        public void setName(String name) { this.name = name; }
        public void setAge(int age) { this.age = age; }
        public void setActive(boolean active) { this.active = active; }
        public void setSubBean(SubBean subBean) { this.subBean = subBean; }

        /* ----- Collection adder ----- */
        public void addItems(String item) { this.items.add(item); }

        /* ----- Getters for assertions ----- */
        public String getName() { return name; }
        public int getAge() { return age; }
        public boolean isActive() { return active; }
        public SubBean getSubBean() { return subBean; }
        public List<String> getItems() { return items; }
    }

    /** A dummy complex property type. */
    public static class SubBean {
        private String data = "default";
        public String getData() { return data; }
        public void setData(String data) { this.data = data; }
    }

    /* --------------------------------------------------------------------- */
    /*  Test fixtures                                                       */
    /* --------------------------------------------------------------------- */

    private BeanDescriptionCache beanDescriptionCache;
    private TestBean testBean;
    private PropertySetter propertySetter;

    @Before
    public void setUp() {
        beanDescriptionCache = new BeanDescriptionCache(new SimpleContext());
        testBean = new TestBean();
        propertySetter = new PropertySetter(beanDescriptionCache, testBean);
    }

    /* --------------------------------------------------------------------- */
    /*  Public API – basic functionality                                    */
    /* --------------------------------------------------------------------- */

    @Test
    public void testSetProperty_String() {
        propertySetter.setProperty("name", "John");
        assertEquals("John", testBean.getName());
    }

    @Test
    public void testSetProperty_Int() {
        propertySetter.setProperty("age", "42");
        assertEquals(42, testBean.getAge());
    }

    @Test
    public void testSetProperty_Boolean() {
        propertySetter.setProperty("active", "true");
        assertTrue(testBean.isActive());
    }

    @Test
    public void testAddBasicProperty_Valid() {
        propertySetter.addBasicProperty("items", "firstItem");
        assertEquals(1, testBean.getItems().size());
        assertEquals("firstItem", testBean.getItems().get(0));
    }

    @Test
    public void testAddComplexProperty_Valid() {
        SubBean sub = new SubBean();
        propertySetter.addComplexProperty("subBean", sub);
        assertSame(sub, testBean.getSubBean());
    }

    @Test
    public void testSetComplexProperty_Valid() {
        SubBean sub = new SubBean();
        propertySetter.setComplexProperty("subBean", sub);
        assertSame(sub, testBean.getSubBean());
    }

    @Test
    public void testComputeAggregationType_ReturnsNonNull() {
        AggregationType type = propertySetter.computeAggregationType("name");
        assertNotNull(type);
    }

    @Test
    public void testGetObjClass() {
        assertEquals(TestBean.class, propertySetter.getObjClass());
    }

    @Test
    public void testGetObj() {
        assertSame(testBean, propertySetter.getObj());
    }

    @Test
    public void testGetClassNameViaImplicitRules_DoesNotThrow() {
        DefaultNestedComponentRegistry registry = new DefaultNestedComponentRegistry();
        // The method may legitimately return null – we only verify that it does not explode.
        Class<?> cls = propertySetter.getClassNameViaImplicitRules(
                "subBean", AggregationType.AS_COMPLEX_PROPERTY, registry);
        // No assertion on the value; the call itself must succeed.
        assertTrue(true);
    }

    /* --------------------------------------------------------------------- */
    /*  Edge cases and exception handling                                    */
    /* --------------------------------------------------------------------- */

    @Test
    public void testSetProperty_NullValue_IsIgnored() {
        propertySetter.setProperty("name", null);
        assertNull(testBean.getName()); // unchanged (still null)
    }

    @Test
    public void testSetProperty_NoCorrespondingSetter_WarnsSilently() {
        // "unknown" has no setter – the method should swallow the problem.
        propertySetter.setProperty("unknown", "value");
        // No exception, bean unchanged.
        assertNull(testBean.getName());
    }

    @Test
    public void testSetProperty_InvalidIntConversion_DoesNotChangeProperty() {
        propertySetter.setProperty("age", "notANumber");
        // The conversion fails; age should remain its default value (0).
        assertEquals(0, testBean.getAge());
    }

    @Test
    public void testAddBasicProperty_NullString_IsIgnored() {
        propertySetter.addBasicProperty("items", null);
        assertTrue(testBean.getItems().isEmpty());
    }

    @Test
    public void testAddBasicProperty_NoAdder_WarnsSilently() {
        // "nonExisting" has no adder method.
        propertySetter.addBasicProperty("nonExisting", "value");
        // No exception, collection unchanged.
        assertTrue(testBean.getItems().isEmpty());
    }

    @Test
    public void testAddBasicProperty_ConversionFailure_DoesNotAdd() {
        // The adder expects a String, conversion will never fail, so we force a failure
        // by using a property that expects a different type (e.g., a non‑existent adder).
        propertySetter.addBasicProperty("age", "123"); // there is no adder for "age"
        // No addition should happen.
        assertTrue(testBean.getItems().isEmpty());
    }

    @Test
    public void testAddComplexProperty_TypeMismatch_IsRejected() {
        // Trying to add a String where a SubBean is required.
        propertySetter.addComplexProperty("subBean", "I am not a SubBean");
        // The property must stay null because the type check fails.
        assertNull(testBean.getSubBean());
    }

    @Test
    public void testSetComplexProperty_NoSetter_WarnsSilently() {
        propertySetter.setComplexProperty("nonExisting", new Object());
        // No exception, nothing to assert on the bean.
        assertNull(testBean.getSubBean());
    }

    @Test
    public void testSetComplexProperty_TypeMismatch_IsRejected() {
        propertySetter.setComplexProperty("subBean", "wrong type");
        assertNull(testBean.getSubBean());
    }

    /* --------------------------------------------------------------------- */
    /*  Verification of private helper (sanity check) behaviour indirectly  */
    /* --------------------------------------------------------------------- */

    @Test
    public void testAddComplexProperty_WithCorrectNameButWrongCapitalisation() {
        // The assessor normalises the name; we verify that the method still works.
        SubBean sub = new SubBean();
        propertySetter.addComplexProperty("SubBean", sub); // capitalised name
        assertSame(sub, testBean.getSubBean());
    }

    @Test
    public void testSetProperty_WhitespaceName_IsIgnoredBecauseNoSetter() {
        propertySetter.setProperty("  ", "value");
        // No exception – the name after trimming does not correspond to any setter.
        assertNull(testBean.getName());
    }
}
