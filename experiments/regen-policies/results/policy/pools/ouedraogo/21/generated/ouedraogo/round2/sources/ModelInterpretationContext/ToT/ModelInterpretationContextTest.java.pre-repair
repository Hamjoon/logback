package ch.qos.logback.core.model.processor;

import org.junit.Before;
import org.junit.Test;
import static org.junit.Assert.*;

import java.util.*;
import java.util.concurrent.*;

import ch.qos.logback.core.Context;
import ch.qos.logback.core.spi.StatusManager;
import ch.qos.logback.core.spi.PropertyContainer;
import ch.qos.logback.core.util.OptionHelper;
import ch.qos.logback.core.util.OptionHelper;
import ch.qos.logback.core.joran.JoranConstants;
import ch.qos.logback.core.joran.util.beans.BeanDescriptionCache;
import ch.qos.logback.core.joran.spi.DefaultNestedComponentRegistry;
import ch.qos.logback.core.model.processor.DependencyDefinition;

/**
 * Comprehensive JUnit4 test suite for {@link ModelInterpretationContext}.
 *
 * The tests cover:
 * <ul>
 *   <li>Construction and initial state</li>
 *   <li>Object and model stack operations</li>
 *   <li>Property handling, substitution and imports</li>
 *   <li>Dependency definition handling</li>
 *   <li>Appenders bag creation</li>
 *   <li>Copy‑constructor semantics</li>
 * </ul>
 *
 * No external mocking frameworks are used – a minimal {@link StubContext}
 * implementation supplies the required {@link Context} contract.
 */
public class ModelInterpretationContextTest {

    /** Simple in‑memory implementation of {@link Context} used by the tests. */
    private static class StubContext implements Context {
        private final Map<String, Object> objectMap = new HashMap<>();
        private final Map<String, String> propertyMap = new HashMap<>();
        private String name = "stub";

        @Override public StatusManager getStatusManager() { return null; }
        @Override public Object getObject(String key) { return objectMap.get(key); }
        @Override public void putObject(String key, Object value) { objectMap.put(key, value); }
        @Override public String getProperty(String key) { return propertyMap.get(key); }
        @Override public void putProperty(String key, String value) { propertyMap.put(key, value); }
        @Override public Map<String, String> getCopyOfPropertyMap() { return new HashMap<>(propertyMap); }
        @Override public String getName() { return name; }
        @Override public void setName(String name) { this.name = name; }
        @Override public long getBirthTime() { return 0L; }
        @Override public Object getConfigurationLock() { return new Object(); }
        @Override public ScheduledExecutorService getScheduledExecutorService() { return null; }
        @Override public ExecutorService getExecutorService() { return null; }
        @Override public void register(ch.qos.logback.core.spi.LifeCycle component) {}
        @Override public void addScheduledFuture(ScheduledFuture<?> scheduledFuture) {}
        @Override public ch.qos.logback.core.spi.SequenceNumberGenerator getSequenceNumberGenerator() { return null; }
        @Override public void setSequenceNumberGenerator(ch.qos.logback.core.spi.SequenceNumberGenerator sequenceNumberGenerator) {}
        @Override public void addConfigurationEventListener(ch.qos.logback.core.spi.ConfigurationEventListener listener) {}
        @Override public void fireConfigurationEvent(ch.qos.logback.core.spi.ConfigurationEvent configurationEvent) {}
    }

    private StubContext context;
    private ModelInterpretationContext mic;

    @Before
    public void setUp() {
        context = new StubContext();
        mic = new ModelInterpretationContext(context);
    }

    // -------------------------------------------------------------------------
    // Construction & basic fields
    // -------------------------------------------------------------------------

    @Test
    public void testConstructorInitialState() {
        assertNotNull(mic.getObjectStack());
        assertTrue(mic.isObjectStackEmpty());

        assertNotNull(mic.getObjectMap());
        assertTrue(mic.getObjectMap().isEmpty());

        assertNotNull(mic.getCopyOfPropertyMap());
        assertTrue(mic.getCopyOfPropertyMap().isEmpty());

        assertNull(mic.getTopModel());
        assertNull(mic.getConfiguratorHint());

        // model stack must be empty
        assertTrue(mic.isModelStackEmpty());
    }

    @Test
    public void testConstructorWithHint() {
        Object hint = new Object();
        ModelInterpretationContext mic2 = new ModelInterpretationContext(context, hint);
        assertSame(hint, mic2.getConfiguratorHint());
    }

    // -------------------------------------------------------------------------
    // Appender bag creation
    // -------------------------------------------------------------------------

    @Test
    public void testCreateAppenderBags() {
        mic.createAppenderBags();
        Map<String, Object> map = mic.getObjectMap();

        assertTrue(map.containsKey(JoranConstants.APPENDER_BAG));
        assertTrue(map.containsKey(JoranConstants.APPENDER_REF_BAG));

        assertTrue(map.get(JoranConstants.APPENDER_BAG) instanceof Map);
        assertTrue(map.get(JoranConstants.APPENDER_REF_BAG) instanceof Map);
    }

    // -------------------------------------------------------------------------
    // Top model getter / setter
    // -------------------------------------------------------------------------

    @Test
    public void testTopModelGetterSetter() {
        Model model = new Model();
        mic.setTopModel(model);
        assertSame(model, mic.getTopModel());
    }

    // -------------------------------------------------------------------------
    // Model stack operations
    // -------------------------------------------------------------------------

    @Test
    public void testModelStackOperations() {
        Model m1 = new Model();
        Model m2 = new Model();

        assertTrue(mic.isModelStackEmpty());

        mic.pushModel(m1);
        assertFalse(mic.isModelStackEmpty());
        assertSame(m1, mic.peekModel());

        mic.pushModel(m2);
        assertSame(m2, mic.peekModel());

        Model popped = mic.popModel();
        assertSame(m2, popped);
        assertSame(m1, mic.peekModel());

        mic.popModel();
        assertTrue(mic.isModelStackEmpty());
    }

    // -------------------------------------------------------------------------
    // Object stack operations
    // -------------------------------------------------------------------------

    @Test
    public void testObjectStackOperations() {
        String obj1 = "first";
        Integer obj2 = 42;

        assertTrue(mic.isObjectStackEmpty());

        mic.pushObject(obj1);
        assertFalse(mic.isObjectStackEmpty());
        assertSame(obj1, mic.peekObject());

        mic.pushObject(obj2);
        assertSame(obj2, mic.peekObject());

        assertSame(obj2, mic.popObject());
        assertSame(obj1, mic.peekObject());

        mic.pushObject(obj2);
        assertSame(obj1, mic.getObject(0));
        assertSame(obj2, mic.getObject(1));
    }

    // -------------------------------------------------------------------------
    // Configurator hint
    // -------------------------------------------------------------------------

    @Test
    public void testConfiguratorHint() {
        Object hint = new Object();
        mic.setConfiguratorHint(hint);
        assertSame(hint, mic.getConfiguratorHint());
    }

    // -------------------------------------------------------------------------
    // BeanDescriptionCache accessor
    // -------------------------------------------------------------------------

    @Test
    public void testGetBeanDescriptionCache() {
        BeanDescriptionCache cache = mic.getBeanDescriptionCache();
        assertNotNull(cache);
        // The cache is created with the same context we passed in.
        assertSame(context, cache.getContext());
    }

    // -------------------------------------------------------------------------
    // Property substitution handling
    // -------------------------------------------------------------------------

    @Test
    public void testAddSubstitutionProperty() {
        mic.addSubstitutionProperty(null, "value");
        mic.addSubstitutionProperty("key", null);
        assertTrue(mic.getCopyOfPropertyMap().isEmpty());

        mic.addSubstitutionProperty(" key ", "  value  ");
        Map<String, String> copy = mic.getCopyOfPropertyMap();
        assertEquals(1, copy.size());
        assertEquals("value", copy.get(" key ")); // key is not trimmed per implementation
    }

    @Test
    public void testAddSubstitutionProperties() {
        Properties props = new Properties();
        props.setProperty("a", "  1  ");
        props.setProperty("b", "2");
        mic.addSubstitutionProperties(props);

        Map<String, String> copy = mic.getCopyOfPropertyMap();
        assertEquals(2, copy.size());
        assertEquals("1", copy.get("a"));
        assertEquals("2", copy.get("b"));
    }

    @Test
    public void testSubstVariableResolution() {
        mic.addSubstitutionProperty("myKey", "myValue");
        String result = mic.subst("${myKey}");
        assertEquals("myValue", result);
    }

    @Test
    public void testSubstNullInput() {
        assertNull(mic.subst(null));
    }

    // -------------------------------------------------------------------------
    // Dependency handling
    // -------------------------------------------------------------------------

    @Test
    public void testDependencyDefinitionLifecycle() {
        Model depender = new Model();
        DependencyDefinition dd = new DependencyDefinition(depender, "someDependee");
        mic.addDependencyDefinition(dd);

        // Unmodifiable view
        List<DependencyDefinition> list = mic.getDependencyDefinitions();
        assertEquals(1, list.size());
        assertSame(dd, list.get(0));
        try {
            list.add(dd);
            fail("Expected UnsupportedOperationException");
        } catch (UnsupportedOperationException ignored) {}

        // Dependee lookup
        List<String> dependees = mic.getDependeeNamesForModel(depender);
        assertEquals(1, dependees.size());
        assertEquals("someDependee", dependees.get(0));

        // hasDependers
        assertTrue(mic.hasDependers("someDependee"));
        assertFalse(mic.hasDependers("unknown"));
        // null / empty strings should safely return false (the method only creates an exception)
        assertFalse(mic.hasDependers(null));
        assertFalse(mic.hasDependers(""));
    }

    @Test
    public void testNamedDependeeTracking() {
        String name = "myDep";
        assertFalse(mic.isNamedDependeeStarted(name));
        mic.markStartOfNamedDependee(name);
        assertTrue(mic.isNamedDependeeStarted(name));
    }

    // -------------------------------------------------------------------------
    // Property retrieval (MIC vs Context precedence)
    // -------------------------------------------------------------------------

    @Test
    public void testGetPropertyPrecedence() {
        // property only in context
        context.putProperty("cKey", "cValue");
        assertEquals("cValue", mic.getProperty("cKey"));

        // same key in MIC overrides context
        mic.addSubstitutionProperty("cKey", "micValue");
        assertEquals("micValue", mic.getProperty("cKey"));
    }

    @Test
    public void testGetCopyOfPropertyMapIsIndependent() {
        mic.addSubstitutionProperty("k", "v");
        Map<String, String> copy = mic.getCopyOfPropertyMap();
        assertEquals("v", copy.get("k"));
        copy.put("k2", "v2");
        // original map must stay unchanged
        assertNull(mic.getProperty("k2"));
    }

    // -------------------------------------------------------------------------
    // Import handling
    // -------------------------------------------------------------------------

    @Test
    public void testImportHandling() {
        mic.addImport("List", "java.util.List");
        mic.addImport("Map", "java.util.Map");

        assertEquals("java.util.List", mic.getImport("List"));
        assertEquals("java.util.Map", mic.getImport("Map"));
        // unknown stem returns the stem itself
        assertEquals("Foo", mic.getImport("Foo"));
        // null stem returns null
        assertNull(mic.getImport(null));

        Map<String, String> copy = mic.getImportMapCopy();
        assertEquals(2, copy.size());
        assertEquals("java.util.List", copy.get("List"));
        // modifying the copy must not affect the original import map
        copy.put("New", "x");
        assertNull(mic.getImport("New"));
    }

    // -------------------------------------------------------------------------
    // Copy‑constructor semantics
    // -------------------------------------------------------------------------

    @Test
    public void testCopyConstructorCopiesState() {
        // populate original MIC
        mic.addSubstitutionProperty("p1", "v1");
        mic.addImport("S", "java.lang.String");
        Model model = new Model();
        mic.setTopModel(model);
        mic.markStartOfNamedDependee("started");

        // invoke copy constructor
        ModelInterpretationContext micCopy = new ModelInterpretationContext(mic);

        // propertiesMap should be copied (value present, but map is distinct)
        assertEquals("v1", micCopy.getProperty("p1"));
        assertNotSame(mic.getCopyOfPropertyMap(), micCopy.getCopyOfPropertyMap());

        // importMap should be copied
        assertEquals("java.lang.String", micCopy.getImport("S"));
        assertNotSame(mic.getImportMapCopy(), micCopy.getImportMapCopy());

        // topModel is not copied – it stays null unless set explicitly
        assertNull(micCopy.getTopModel());

        // startedDependees list is NOT copied (should be empty)
        assertFalse(micCopy.isNamedDependeeStarted("started"));

        // defaultNestedComponentRegistry should be duplicated without error
        // (no public accessor to verify its internal state, just ensure no NPE)
        assertNotNull(micCopy.getDefaultNestedComponentRegistry());

        // copy constructor also creates empty appender bags
        micCopy.createAppenderBags();
        assertTrue(micCopy.getObjectMap().containsKey(JoranConstants.APPENDER_BAG));
        assertTrue(micCopy.getObjectMap().containsKey(JoranConstants.APPENDER_REF_BAG));
    }

    // -------------------------------------------------------------------------
    // Additional edge cases for model/ object stack emptiness
    // -------------------------------------------------------------------------

    @Test(expected = EmptyStackException.class)
    public void testPeekModelOnEmptyStackThrows() {
        mic.peekModel();
    }

    @Test(expected = EmptyStackException.class)
    public void testPopObjectOnEmptyStackThrows() {
        mic.popObject();
    }
}
