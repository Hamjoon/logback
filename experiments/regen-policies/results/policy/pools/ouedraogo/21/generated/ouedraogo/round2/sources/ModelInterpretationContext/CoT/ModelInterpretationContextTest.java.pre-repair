package ch.qos.logback.core.model.processor;

import static org.junit.Assert.*;

import java.util.Collections;
import java.util.HashMap;
import java.util.Map;
import java.util.Properties;
import java.util.Stack;
import java.util.concurrent.ExecutorService;
import java.util.concurrent.ScheduledExecutorService;

import org.junit.Before;
import org.junit.Test;

import ch.qos.logback.core.Context;
import ch.qos.logback.core.StatusManager;
import ch.qos.logback.core.joran.JoranConstants;
import ch.qos.logback.core.joran.spi.DefaultNestedComponentRegistry;
import ch.qos.logback.core.spi.AppenderAttachable;
import ch.qos.logback.core.spi.BeanDescriptionCache;
import ch.qos.logback.core.spi.ScanException;
import ch.qos.logback.core.util.OptionHelper;

/**
 * Unit tests for {@link ModelInterpretationContext}.
 *
 * The tests cover:
 * <ul>
 *   <li>All public methods (basic behaviour)</li>
 *   <li>Edge cases such as null arguments, empty strings, duplicate entries</li>
 *   <li>Exception handling in {@code subst}</li>
 * </ul>
 *
 * A very small {@link Context} implementation is provided inside the test
 * class because the real Logback {@code Context} is an interface and no concrete
 * implementation is available in the supplied API list.
 */
public class ModelInterpretationContextTest {

    /** Minimal {@link Context} implementation used only for the tests. */
    private static class SimpleContext implements Context {

        private final Map<String, String> properties = new HashMap<>();

        @Override
        public String getProperty(String key) {
            return properties.get(key);
        }

        @Override
        public void putProperty(String key, String value) {
            properties.put(key, value);
        }

        // -----------------------------------------------------------------
        // The remaining methods are not needed for the current tests.
        // They are implemented with simple stubs or throw
        // UnsupportedOperationException to keep the implementation minimal.
        // -----------------------------------------------------------------
        @Override public StatusManager getStatusManager() { return null; }
        @Override public Object getObject(String key) { return null; }
        @Override public void putObject(String key, Object value) {}
        @Override public Map<String, String> getCopyOfPropertyMap() { return new HashMap<>(properties); }
        @Override public String getName() { return null; }
        @Override public void setName(String name) {}
        @Override public long getBirthTime() { return 0L; }
        @Override public Object getConfigurationLock() { return null; }
        @Override public ScheduledExecutorService getScheduledExecutorService() { return null; }
        @Override public ExecutorService getExecutorService() { return null; }
        @Override public ExecutorService getAlternateExecutorService() { return null; }
        @Override public void register(ch.qos.logback.core.spi.LifeCycle component) {}
        @Override public void addScheduledFuture(java.util.concurrent.ScheduledFuture<?> scheduledFuture) {}
        @Override public ch.qos.logback.core.spi.SequenceNumberGenerator getSequenceNumberGenerator() { return null; }
        @Override public void setSequenceNumberGenerator(ch.qos.logback.core.spi.SequenceNumberGenerator sequenceNumberGenerator) {}
        @Override public void addConfigurationEventListener(ch.qos.logback.core.spi.ConfigurationEventListener listener) {}
        @Override public void fireConfigurationEvent(ch.qos.logback.core.spi.ConfigurationEvent configurationEvent) {}
    }

    private SimpleContext simpleContext;
    private ModelInterpretationContext mic;

    @Before
    public void setUp() {
        simpleContext = new SimpleContext();
        mic = new ModelInterpretationContext(simpleContext);
    }

    // -----------------------------------------------------------------
    // 1. Constructors and simple getters / setters
    // -----------------------------------------------------------------
    @Test
    public void testConstructorWithContextOnly() {
        ModelInterpretationContext mic2 = new ModelInterpretationContext(simpleContext);
        assertNotNull(mic2);
        assertSame(simpleContext, mic2.getContext());
        assertNull(mic2.getConfiguratorHint());
    }

    @Test
    public void testConstructorWithContextAndHint() {
        Object hint = new Object();
        ModelInterpretationContext mic2 = new ModelInterpretationContext(simpleContext, hint);
        assertSame(hint, mic2.getConfiguratorHint());
    }

    @Test
    public void testCopyConstructorCopiesMapsAndRegistry() {
        mic.addImport("List", "java.util.List");
        mic.addSubstitutionProperty("key", "value");
        mic.getDefaultNestedComponentRegistry().add(String.class, "prop", Integer.class);

        ModelInterpretationContext copy = new ModelInterpretationContext(mic);
        assertEquals("value", copy.getProperty("key"));
        assertEquals("java.util.List", copy.getImport("List"));
        // the registry is duplicated – we check that a new instance exists
        assertNotSame(mic.getDefaultNestedComponentRegistry(),
                      copy.getDefaultNestedComponentRegistry());
    }

    @Test
    public void testTopModelGetterSetter() {
        Model model = new Model();
        mic.setTopModel(model);
        assertSame(model, mic.getTopModel());
    }

    // -----------------------------------------------------------------
    // 2. Model stack operations
    // -----------------------------------------------------------------
    @Test
    public void testModelStackPushPeekPop() {
        Model m1 = new Model();
        Model m2 = new Model();

        assertTrue(mic.isModelStackEmpty());

        mic.pushModel(m1);
        assertFalse(mic.isModelStackEmpty());
        assertSame(m1, mic.peekModel());

        mic.pushModel(m2);
        assertSame(m2, mic.peekModel());

        assertSame(m2, mic.popModel());
        assertSame(m1, mic.peekModel());
        assertSame(m1, mic.popModel());
        assertTrue(mic.isModelStackEmpty());
    }

    // -----------------------------------------------------------------
    // 3. Object stack operations
    // -----------------------------------------------------------------
    @Test
    public void testObjectStackPushPeekPop() {
        String obj1 = "first";
        Integer obj2 = 42;

        assertTrue(mic.isObjectStackEmpty());

        mic.pushObject(obj1);
        assertFalse(mic.isObjectStackEmpty());
        assertSame(obj1, mic.peekObject());

        mic.pushObject(obj2);
        assertSame(obj2, mic.peekObject());

        assertSame(obj2, mic.popObject());
        assertSame(obj1, mic.peekObject());

        assertSame(obj1, mic.getObject(0));
        assertSame(obj1, mic.popObject());
        assertTrue(mic.isObjectStackEmpty());
    }

    // -----------------------------------------------------------------
    // 4. Configurator hint getter/setter
    // -----------------------------------------------------------------
    @Test
    public void testConfiguratorHint() {
        Object hint = new Object();
        mic.setConfiguratorHint(hint);
        assertSame(hint, mic.getConfiguratorHint());
    }

    // -----------------------------------------------------------------
    // 5. BeanDescriptionCache getter (only existence is verified)
    // -----------------------------------------------------------------
    @Test
    public void testBeanDescriptionCacheNotNull() {
        BeanDescriptionCache cache = mic.getBeanDescriptionCache();
        assertNotNull(cache);
    }

    // -----------------------------------------------------------------
    // 6. subst(String) – normal substitution, null handling and exception handling
    // -----------------------------------------------------------------
    @Test
    public void testSubstNullReturnsNull() {
        assertNull(mic.subst(null));
    }

    @Test
    public void testSubstVariableIsReplacedUsingContextProperties() {
        // put a property in the context
        simpleContext.putProperty("myProp", "myValue");
        String input = "value=${myProp}";
        String expected = "value=myValue";
        assertEquals(expected, mic.subst(input));
    }

    @Test
    public void testSubstWhenOptionHelperThrowsReturnsOriginal() {
        // Force a ScanException by passing an illegal variable syntax.
        // OptionHelper throws ScanException for a variable that contains a space.
        String badRef = "${illegal var}";
        String result = mic.subst(badRef);
        // The method should catch the exception and return the original string.
        assertEquals(badRef, result);
    }

    // -----------------------------------------------------------------
    // 7. Substitution property handling
    // -----------------------------------------------------------------
    @Test
    public void testAddSubstitutionPropertyNormal() {
        mic.addSubstitutionProperty("key", "  value  ");
        assertEquals("value", mic.getProperty("key"));
    }

    @Test
    public void testAddSubstitutionPropertyIgnoresNullKeyOrValue() {
        mic.addSubstitutionProperty(null, "value");
        mic.addSubstitutionProperty("key", null);
        assertNull(mic.getProperty("key"));
    }

    @Test
    public void testAddSubstitutionPropertiesFromPropertiesObject() {
        Properties props = new Properties();
        props.setProperty("a", "  A  ");
        props.setProperty("b", "B");
        mic.addSubstitutionProperties(props);
        assertEquals("A", mic.getProperty("a"));
        assertEquals("B", mic.getProperty("b"));
    }

    @Test
    public void testAddSubstitutionPropertiesIgnoresNullArgument() {
        // should not throw any exception
        mic.addSubstitutionProperties(null);
        // map remains empty
        assertTrue(mic.getCopyOfPropertyMap().isEmpty());
    }

    // -----------------------------------------------------------------
    // 8. Appender bags creation
    // -----------------------------------------------------------------
    @Test
    public void testCreateAppenderBagsCreatesExpectedEntries() {
        mic.createAppenderBags();
        Map<String, Object> map = mic.getObjectMap();
        assertTrue(map.containsKey(JoranConstants.APPENDER_BAG));
        assertTrue(map.containsKey(JoranConstants.APPENDER_REF_BAG));
        assertTrue(map.get(JoranConstants.APPENDER_BAG) instanceof Map);
        assertTrue(map.get(JoranConstants.APPENDER_REF_BAG) instanceof Map);
    }

    // -----------------------------------------------------------------
    // 9. Dependency handling
    // -----------------------------------------------------------------
    @Test
    public void testAddAndRetrieveDependencyDefinitions() {
        Model depender = new Model();
        DependencyDefinition dd = new DependencyDefinition(depender, "someDependee");
        mic.addDependencyDefinition(dd);

        assertEquals(1, mic.getDependencyDefinitions().size());
        assertSame(dd, mic.getDependencyDefinitions().get(0));

        // getDependeeNamesForModel should return the dependee name for the given model
        assertEquals(Collections.singletonList("someDependee"),
                     mic.getDependeeNamesForModel(depender));

        // hasDependers should be true for the known dependee name
        assertTrue(mic.hasDependers("someDependee"));
    }

    @Test
    public void testHasDependersWithNullOrEmptyNameReturnsFalse() {
        // According to the implementation, an IllegalArgumentException is instantiated
        // but not thrown. The method should simply return false.
        assertFalse(mic.hasDependers(null));
        assertFalse(mic.hasDependers(""));
        assertFalse(mic.hasDependers("   "));
    }

    // -----------------------------------------------------------------
    // 10. Named dependee tracking
    // -----------------------------------------------------------------
    @Test
    public void testMarkAndCheckNamedDependee() {
        String name = "myDependee";
        assertFalse(mic.isNamedDependeeStarted(name));
        mic.markStartOfNamedDependee(name);
        assertTrue(mic.isNamedDependeeStarted(name));
    }

    // -----------------------------------------------------------------
    // 11. Property retrieval – own map vs context fallback
    // -----------------------------------------------------------------
    @Test
    public void testGetPropertyPrefersLocalMap() {
        mic.addSubstitutionProperty("key", "local");
        simpleContext.putProperty("key", "context");
        assertEquals("local", mic.getProperty("key"));
    }

    @Test
    public void testGetPropertyFallsBackToContext() {
        simpleContext.putProperty("key", "context");
        assertEquals("context", mic.getProperty("key"));
    }

    @Test
    public void testGetCopyOfPropertyMapIsIndependent() {
        mic.addSubstitutionProperty("k", "v");
        Map<String, String> copy = mic.getCopyOfPropertyMap();
        assertEquals("v", copy.get("k"));
        // modifying the copy must not affect the original map
        copy.put("k", "changed");
        assertEquals("v", mic.getProperty("k"));
    }

    // -----------------------------------------------------------------
    // 12. Import handling
    // -----------------------------------------------------------------
    @Test
    public void testAddAndRetrieveImport() {
        mic.addImport("List", "java.util.List");
        assertEquals("java.util.List", mic.getImport("List"));
        // unknown stem returns the stem itself
        assertEquals("UnknownStem", mic.getImport("UnknownStem"));
        // null stem returns null
        assertNull(mic.getImport(null));
    }

    @Test
    public void testGetImportMapCopyIsIndependent() {
        mic.addImport("Map", "java.util.Map");
        Map<String, String> copy = mic.getImportMapCopy();
        assertEquals("java.util.Map", copy.get("Map"));
        copy.put("Map", "changed");
        assertEquals("java.util.Map", mic.getImport("Map"));
    }

    // -----------------------------------------------------------------
    // 13. DefaultNestedComponentRegistry getter
    // -----------------------------------------------------------------
    @Test
    public void testGetDefaultNestedComponentRegistryNotNull() {
        DefaultNestedComponentRegistry registry = mic.getDefaultNestedComponentRegistry();
        assertNotNull(registry);
    }

    // -----------------------------------------------------------------
    // 14. Object map getter (basic sanity)
    // -----------------------------------------------------------------
    @Test
    public void testGetObjectMapIsMutable() {
        Map<String, Object> map = mic.getObjectMap();
        map.put("testKey", "testValue");
        assertEquals("testValue", mic.getObjectMap().get("testKey"));
    }
}
