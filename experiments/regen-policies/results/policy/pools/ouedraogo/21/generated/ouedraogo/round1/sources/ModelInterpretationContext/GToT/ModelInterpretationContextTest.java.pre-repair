package ch.qos.logback.core.model.processor;

import static org.junit.Assert.*;

import java.util.*;

import org.junit.Before;
import org.junit.Test;

import ch.qos.logback.core.Context;
import ch.qos.logback.core.joran.JoranConstants;
import ch.qos.logback.core.joran.spi.DefaultNestedComponentRegistry;
import ch.qos.logback.core.joran.util.beans.BeanDescriptionCache;
import ch.qos.logback.core.spi.ScanException;
import ch.qos.logback.core.util.OptionHelper;

/**
 * Comprehensive JUnit‑4 test suite for {@link ModelInterpretationContext}.
 *
 * The tests cover:
 * <ul>
 *   <li>All public API methods (basic happy‑path tests)</li>
 *   <li>Identified edge‑cases and error handling (null arguments, trimming,
 *       unknown imports, empty dependency names, etc.)</li>
 * </ul>
 *
 * A very small in‑memory {@link Context} implementation is provided
 * ( {@code SimpleContext} ) because the real Logback {@code ContextBase}
 * class is not part of the allowed API list. The implementation supplies
 * only the methods exercised by the class under test.
 */
public class ModelInterpretationContextTest {

    /** Minimal {@link Context} implementation used only for the tests. */
    private static class SimpleContext implements Context {
        private final Map<String, String> properties = new HashMap<>();
        private final Map<String, Object> objects = new HashMap<>();

        @Override public void setContext(Context context) { /* no‑op */ }
        @Override public Context getContext() { return this; }
        @Override public void addStatus(Object status) { /* no‑op */ }
        @Override public void addInfo(String msg) { /* no‑op */ }
        @Override public void addInfo(String msg, Throwable ex) { /* no‑op */ }
        @Override public void addWarn(String msg) { /* no‑op */ }
        @Override public void addWarn(String msg, Throwable ex) { /* no‑op */ }
        @Override public void addError(String msg) { /* no‑op */ }
        @Override public void addError(String msg, Throwable ex) { /* no‑op */ }

        @Override public String getProperty(String key) { return properties.get(key); }
        @Override public void putProperty(String key, String value) { properties.put(key, value); }
        @Override public Map<String, String> getCopyOfPropertyMap() { return new HashMap<>(properties); }

        @Override public Object getObject(String key) { return objects.get(key); }
        @Override public void putObject(String key, Object value) { objects.put(key, value); }

        @Override public String getName() { return "simple"; }
        @Override public void setName(String name) { /* no‑op */ }
        @Override public long getBirthTime() { return System.currentTimeMillis(); }
        @Override public Object getConfigurationLock() { return this; }
        @Override public java.util.concurrent.ScheduledExecutorService getScheduledExecutorService() { return null; }
        @Override public java.util.concurrent.ExecutorService getExecutorService() { return null; }
        @Override public java.util.concurrent.ExecutorService getAlternateExecutorService() { return null; }
        @Override public void register(Object component) { /* no‑op */ }
        @Override public void addScheduledFuture(java.util.concurrent.ScheduledFuture<?> scheduledFuture) { /* no‑op */ }
        @Override public Object getSequenceNumberGenerator() { return null; }
        @Override public void setSequenceNumberGenerator(Object sequenceNumberGenerator) { /* no‑op */ }
        @Override public void addConfigurationEventListener(Object listener) { /* no‑op */ }
        @Override public void fireConfigurationEvent(Object configurationEvent) { /* no‑op */ }
    }

    private SimpleContext context;
    private ModelInterpretationContext mic;

    @Before
    public void setUp() {
        context = new SimpleContext();
        mic = new ModelInterpretationContext(context);
    }

    // -----------------------------------------------------------------------
    //  Basic API tests (happy path)
    // -----------------------------------------------------------------------

    @Test
    public void testGetObjectMapInitiallyEmpty() {
        Map<String, Object> map = mic.getObjectMap();
        assertNotNull(map);
        assertTrue(map.isEmpty());
    }

    @Test
    public void testCreateAppenderBagsPopulatesObjectMap() {
        mic.createAppenderBags();
        Map<String, Object> map = mic.getObjectMap();
        assertTrue(map.containsKey(JoranConstants.APPENDER_BAG));
        assertTrue(map.containsKey(JoranConstants.APPENDER_REF_BAG));
        assertTrue(map.get(JoranConstants.APPENDER_BAG) instanceof Map);
        assertTrue(map.get(JoranConstants.APPENDER_REF_BAG) instanceof Map);
    }

    @Test
    public void testTopModelGetterSetter() {
        Model model = new Model();
        mic.setTopModel(model);
        assertSame(model, mic.getTopModel());
    }

    @Test
    public void testModelStackOperations() {
        Model m1 = new Model();
        Model m2 = new Model();
        assertTrue(mic.isModelStackEmpty());
        mic.pushModel(m1);
        assertFalse(mic.isModelStackEmpty());
        assertSame(m1, mic.peekModel());
        mic.pushModel(m2);
        assertSame(m2, mic.peekModel());
        assertSame(m2, mic.popModel());
        assertSame(m1, mic.popModel());
        assertTrue(mic.isModelStackEmpty());
    }

    @Test
    public void testObjectStackOperations() {
        String o1 = "first";
        Integer o2 = 42;
        assertTrue(mic.isObjectStackEmpty());
        mic.pushObject(o1);
        assertFalse(mic.isObjectStackEmpty());
        assertEquals(o1, mic.peekObject());
        mic.pushObject(o2);
        assertEquals(o2, mic.peekObject());
        assertEquals(o2, mic.popObject());
        assertEquals(o1, mic.popObject());
        assertTrue(mic.isObjectStackEmpty());
    }

    @Test
    public void testGetObjectByIndex() {
        String a = "a";
        String b = "b";
        mic.pushObject(a);
        mic.pushObject(b);
        assertEquals(a, mic.getObject(0));
        assertEquals(b, mic.getObject(1));
    }

    @Test
    public void testConfiguratorHintGetterSetter() {
        Object hint = new Object();
        mic.setConfiguratorHint(hint);
        assertSame(hint, mic.getConfiguratorHint());
    }

    @Test
    public void testGetBeanDescriptionCacheIsNotNull() {
        assertNotNull(mic.getBeanDescriptionCache());
    }

    @Test
    public void testSubstReturnsOriginalWhenNull() {
        assertNull(mic.subst(null));
    }

    @Test
    public void testAddSubstitutionPropertyTrimsValue() {
        mic.addSubstitutionProperty("key", "  value  ");
        assertEquals("value", mic.getProperty("key"));
    }

    @Test
    public void testAddSubstitutionPropertyIgnoresNullKeyOrValue() {
        mic.addSubstitutionProperty(null, "val");
        mic.addSubstitutionProperty("k", null);
        assertNull(mic.getProperty(null));
        assertNull(mic.getProperty("k"));
    }

    @Test
    public void testAddSubstitutionPropertiesHandlesNullGracefully() {
        mic.addSubstitutionProperties(null); // should not throw
        // also test normal case
        Properties props = new Properties();
        props.setProperty("p1", "  v1  ");
        props.setProperty("p2", "v2");
        mic.addSubstitutionProperties(props);
        assertEquals("v1", mic.getProperty("p1"));
        assertEquals("v2", mic.getProperty("p2"));
    }

    @Test
    public void testGetDefaultNestedComponentRegistryIsNotNull() {
        DefaultNestedComponentRegistry reg = mic.getDefaultNestedComponentRegistry();
        assertNotNull(reg);
    }

    @Test
    public void testDependencyDefinitionAndQueries() {
        Model depender = new Model();
        DependencyDefinition dd = new DependencyDefinition(depender, "serviceA");
        mic.addDependencyDefinition(dd);

        List<DependencyDefinition> defs = mic.getDependencyDefinitions();
        assertEquals(1, defs.size());
        assertSame(dd, defs.get(0));

        List<String> dependees = mic.getDependeeNamesForModel(depender);
        assertEquals(Collections.singletonList("serviceA"), dependees);
    }

    @Test
    public void testHasDependersPositiveAndNegative() {
        Model depender = new Model();
        DependencyDefinition dd = new DependencyDefinition(depender, "serviceX");
        mic.addDependencyDefinition(dd);

        assertTrue(mic.hasDependers("serviceX"));
        assertFalse(mic.hasDependers("serviceY"));
    }

    @Test
    public void testMarkStartOfNamedDependeeAndCheck() {
        mic.markStartOfNamedDependee("myDep");
        assertTrue(mic.isNamedDependeeStarted("myDep"));
        assertFalse(mic.isNamedDependeeStarted("other"));
    }

    @Test
    public void testGetPropertyFallsBackToContext() {
        context.putProperty("ctxKey", "ctxValue");
        assertEquals("ctxValue", mic.getProperty("ctxKey"));
    }

    @Test
    public void testGetCopyOfPropertyMapIsIndependent() {
        mic.addSubstitutionProperty("k1", "v1");
        Map<String, String> copy = mic.getCopyOfPropertyMap();
        assertEquals("v1", copy.get("k1"));
        // modify copy – original must stay unchanged
        copy.put("k1", "changed");
        assertEquals("v1", mic.getProperty("k1"));
    }

    @Test
    public void testAddAndRetrieveImport() {
        mic.addImport("List", "java.util.List");
        assertEquals("java.util.List", mic.getImport("List"));
        assertEquals("UnknownStem", mic.getImport("UnknownStem"));
        assertNull(mic.getImport(null));
    }

    @Test
    public void testGetImportMapCopyIsIndependent() {
        mic.addImport("Map", "java.util.Map");
        Map<String, String> copy = mic.getImportMapCopy();
        assertEquals("java.util.Map", copy.get("Map"));
        copy.put("Map", "changed");
        assertEquals("java.util.Map", mic.getImport("Map"));
    }

    // -----------------------------------------------------------------------
    //  Edge‑case / exception handling tests
    // -----------------------------------------------------------------------

    @Test
    public void testSubstHandlesOptionHelperException() {
        // OptionHelper.substVars throws ScanException for a malformed variable.
        // Using a variable that contains an illegal character forces the exception.
        String malformed = "${illegal:}";
        String result = mic.subst(malformed);
        // When an exception occurs the method should log the error and return the original string.
        assertEquals(malformed, result);
    }

    @Test
    public void testHasDependersWithNullOrEmptyDoesNotThrow() {
        // The method creates an IllegalArgumentException but does not throw it.
        // We verify that it simply returns false and does not propagate any exception.
        assertFalse(mic.hasDependers(null));
        assertFalse(mic.hasDependers(""));
        assertFalse(mic.hasDependers("   "));
    }

    @Test
    public void testGetDependeeNamesForModelWhenNone() {
        Model model = new Model();
        List<String> deps = mic.getDependeeNamesForModel(model);
        assertTrue(deps.isEmpty());
    }

    @Test
    public void testAddSubstitutionPropertyTrimsOnlySpaces() {
        mic.addSubstitutionProperty("k", "   "); // after trim becomes empty string
        assertEquals("", mic.getProperty("k"));
    }

    @Test
    public void testCreateAppenderBagsDoesNotOverwriteExistingEntries() {
        // Prepare a pre‑existing entry
        mic.getObjectMap().put(JoranConstants.APPENDER_BAG, "preExisting");
        mic.createAppenderBags(); // should overwrite with a new Map
        Object bag = mic.getObjectMap().get(JoranConstants.APPENDER_BAG);
        assertTrue(bag instanceof Map);
        assertNotEquals("preExisting", bag);
    }

    // -----------------------------------------------------------------------
    //  Constructor variants
    // -----------------------------------------------------------------------

    @Test
    public void testCopyConstructorCopiesState() {
        mic.addSubstitutionProperty("a", "1");
        mic.addImport("X", "com.example.X");
        Model top = new Model();
        mic.setTopModel(top);

        ModelInterpretationContext copy = new ModelInterpretationContext(mic);
        assertEquals("1", copy.getProperty("a"));
        assertEquals("com.example.X", copy.getImport("X"));
        assertSame(top, copy.getTopModel());
    }

    @Test
    public void testConstructorWithConfiguratorHint() {
        Object hint = new Object();
        ModelInterpretationContext mic2 = new ModelInterpretationContext(context, hint);
        assertSame(hint, mic2.getConfiguratorHint());
    }
}
