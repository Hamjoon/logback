/**
 * JUnit4 test suite for {@link ch.qos.logback.core.model.processor.ModelInterpretationContext}
 *
 * The tests cover:
 *   - stack operations for both model and object stacks
 *   - object map handling and creation of appender bags
 *   - top model getter/setter
 *   - configurator hint handling
 *   - variable substitution facilities
 *   - dependency definition handling
 *   - import map handling
 *   - configurator supplier handling
 *
 * No external mocking frameworks are used; all required objects are created
 * with concrete implementations available in the supplied API or with tiny
 * test‑only helper classes.
 */
package ch.qos.logback.core.model.processor;

import org.junit.Before;
import org.junit.Test;
import static org.junit.Assert.*;

import java.util.*;
import java.util.function.Supplier;
import java.util.concurrent.ExecutorService;
import java.util.concurrent.ScheduledExecutorService;

import ch.qos.logback.core.*;
import ch.qos.logback.core.joran.GenericXMLConfigurator;
import ch.qos.logback.core.joran.JoranConstants;
import ch.qos.logback.core.joran.spi.DefaultNestedComponentRegistry;
import ch.qos.logback.core.model.util.VariableSubstitutionsHelper;
import ch.qos.logback.core.spi.AppenderAttachable;

/**
 * Minimal {@link Context} implementation for testing purposes.
 * Only the methods needed by {@code ModelInterpretationContext} are fully implemented.
 */
class SimpleContext implements Context {

    private final Map<String, Object> objectMap = new HashMap<>();
    private final Map<String, String> propertyMap = new HashMap<>();
    private String name = "simple-context";

    @Override public StatusManager getStatusManager() { return null; }

    @Override public Object getObject(String key) { return objectMap.get(key); }

    @Override public void putObject(String key, Object value) { objectMap.put(key, value); }

    @Override public String getProperty(String key) { return propertyMap.get(key); }

    @Override public void putProperty(String key, String value) { propertyMap.put(key, value); }

    @Override public Map<String, String> getCopyOfPropertyMap() { return new HashMap<>(propertyMap); }

    @Override public String getName() { return name; }

    @Override public void setName(String name) { this.name = name; }

    @Override public long getBirthTime() { return System.currentTimeMillis(); }

    @Override public Object getConfigurationLock() { return new Object(); }

    @Override public ScheduledExecutorService getScheduledExecutorService() { return null; }

    @Override public ExecutorService getExecutorService() { return null; }

    // default methods from the interface are fine for the rest
    @Override public void register(LifeCycle component) {}
    @Override public void addScheduledFuture(ScheduledFuture<?> scheduledFuture) {}
    @Override public SequenceNumberGenerator getSequenceNumberGenerator() { return null; }
    @Override public void setSequenceNumberGenerator(SequenceNumberGenerator sequenceNumberGenerator) {}
    @Override public void addConfigurationEventListener(ConfigurationEventListener listener) {}
    @Override public void fireConfigurationEvent(ConfigurationEvent configurationEvent) {}
}

/**
 * Minimal concrete {@link GenericXMLConfigurator} to be used as a supplier.
 */
class DummyConfigurator extends GenericXMLConfigurator {

    @Override protected void addElementSelectorAndActionAssociations(RuleStore rs) {}

    @Override protected void setImplicitRuleSupplier(SaxEventInterpreter interpreter) {}

    // all other methods inherited from GenericXMLConfigurator are concrete,
    // so no further implementation is needed for the tests.
}

public class ModelInterpretationContextTest {

    private ModelInterpretationContext mic;
    private SimpleContext context;

    @Before
    public void setUp() {
        context = new SimpleContext();
        mic = new ModelInterpretationContext(context);
    }

    // -----------------------------------------------------------------------
    // Stack handling tests
    // -----------------------------------------------------------------------

    @Test
    public void testModelStackPushPeekPop() {
        Model m1 = new Model();
        Model m2 = new Model();

        assertTrue(mic.isModelStackEmpty());

        mic.pushModel(m1);
        assertFalse(mic.isModelStackEmpty());
        assertSame(m1, mic.peekModel());

        mic.pushModel(m2);
        assertSame(m2, mic.peekModel());

        assertSame(m2, mic.popModel());
        assertSame(m1, mic.peekModel());

        assertSame(m1, mic.popModel());
        assertTrue(mic.isModelStackEmpty());
    }

    @Test
    public void testObjectStackPushPeekPopAndGetByIndex() {
        String obj1 = "first";
        Integer obj2 = 42;

        assertTrue(mic.isObjectStackEmpty());

        mic.pushObject(obj1);
        assertFalse(mic.isObjectStackEmpty());
        assertEquals(obj1, mic.peekObject());
        assertEquals(obj1, mic.getObject(0));

        mic.pushObject(obj2);
        assertEquals(obj2, mic.peekObject());
        assertEquals(obj1, mic.getObject(0));
        assertEquals(obj2, mic.getObject(1));

        assertEquals(obj2, mic.popObject());
        assertEquals(obj1, mic.peekObject());

        assertEquals(obj1, mic.popObject());
        assertTrue(mic.isObjectStackEmpty());
    }

    // -----------------------------------------------------------------------
    // Object map and appender bag creation
    // -----------------------------------------------------------------------

    @Test
    public void testObjectMapInitiallyEmptyAndCreateAppenderBags() {
        Map<String, Object> map = mic.getObjectMap();
        assertNotNull(map);
        assertTrue(map.isEmpty());

        mic.createAppenderBags();

        assertTrue(map.containsKey(JoranConstants.APPENDER_BAG));
        assertTrue(map.containsKey(JoranConstants.APPENDER_REF_BAG));

        // verify the bags are correctly typed
        assertTrue(map.get(JoranConstants.APPENDER_BAG) instanceof Map);
        assertTrue(map.get(JoranConstants.APPENDER_REF_BAG) instanceof Map);
    }

    // -----------------------------------------------------------------------
    // Top model getter / setter
    // -----------------------------------------------------------------------

    @Test
    public void testTopModelGetterSetter() {
        assertNull(mic.getTopModel());

        Model top = new Model();
        mic.setTopModel(top);
        assertSame(top, mic.getTopModel());
    }

    // -----------------------------------------------------------------------
    // Configurator hint handling
    // -----------------------------------------------------------------------

    @Test
    public void testConfiguratorHintGetterSetter() {
        assertNull(mic.getConfiguratorHint());

        String hint = "my-hint";
        mic.setConfiguratorHint(hint);
        assertEquals(hint, mic.getConfiguratorHint());

        Object anotherHint = new Object();
        mic.setConfiguratorHint(anotherHint);
        assertSame(anotherHint, mic.getConfiguratorHint());
    }

    // -----------------------------------------------------------------------
    // Variable substitution through VariableSubstitutionsHelper
    // -----------------------------------------------------------------------

    @Test
    public void testVariableSubstitutionAddAndRetrieve() {
        mic.addSubstitutionProperty("key1", "value1");
        mic.addSubstitutionProperty("key2", "${key1}_suffix");

        // direct property access
        assertEquals("value1", mic.getProperty("key1"));
        assertEquals("${key1}_suffix", mic.getProperty("key2"));

        // substitution should replace ${key1}
        assertEquals("value1_suffix", mic.subst("${key2}"));
    }

    @Test
    public void testGetCopyOfPropertyMapIsIndependent() {
        mic.addSubstitutionProperty("a", "1");
        Map<String, String> copy = mic.getCopyOfPropertyMap();
        assertEquals("1", copy.get("a"));

        // modify original MIC properties and ensure copy does not change
        mic.addSubstitutionProperty("a", "2");
        assertEquals("1", copy.get("a"));
        assertEquals("2", mic.getProperty("a"));
    }

    // -----------------------------------------------------------------------
    // Dependency definition handling
    // -----------------------------------------------------------------------

    @Test
    public void testAddAndRetrieveDependencyDefinitions() {
        Model depender = new Model();
        String dependeeName = "someDependee";

        DependencyDefinition dd = new DependencyDefinition(depender, dependeeName);
        mic.addDependencyDefinition(dd);

        List<DependencyDefinition> defs = mic.getDependencyDefinitions();
        assertEquals(1, defs.size());
        assertSame(dd, defs.get(0));

        // getDependeeNamesForModel should return the dependee name for the given model
        List<String> dependees = mic.getDependeeNamesForModel(depender);
        assertEquals(Collections.singletonList(dependeeName), dependees);
    }

    @Test
    public void testHasDependersAndMarkStartOfNamedDependee() {
        // initially no dependers
        assertFalse(mic.hasDependers("unknown"));

        // add a dependency definition
        Model depender = new Model();
        String dependee = "myDependee";
        mic.addDependencyDefinition(new DependencyDefinition(depender, dependee));

        assertTrue(mic.hasDependers(dependee));

        // empty or null name should not cause an exception (the method creates but does not throw)
        assertFalse(mic.hasDependers(""));
        assertFalse(mic.hasDependers(null));

        // start/started checks
        assertFalse(mic.isNamedDependeeStarted(dependee));
        mic.markStartOfNamedDependee(dependee);
        assertTrue(mic.isNamedDependeeStarted(dependee));
    }

    // -----------------------------------------------------------------------
    // Import map handling
    // -----------------------------------------------------------------------

    @Test
    public void testAddImportAndGetImport() {
        // unknown stem returns the stem itself
        assertEquals("UnknownClass", mic.getImport("UnknownClass"));

        // null stem returns null
        assertNull(mic.getImport(null));

        // add an import and retrieve it
        mic.addImport("List", "java.util.List");
        assertEquals("java.util.List", mic.getImport("List"));

        // ensure the map copy is independent
        Map<String, String> copy = mic.getImportMapCopy();
        assertEquals("java.util.List", copy.get("List"));
        assertNotSame(copy, mic.getImportMapCopy()); // a new map each call
    }

    // -----------------------------------------------------------------------
    // Configurator supplier handling
    // -----------------------------------------------------------------------

    @Test
    public void testConfiguratorSupplierGetterSetter() {
        assertNull(mic.getConfiguratorSupplier());

        Supplier<? extends GenericXMLConfigurator> supplier = DummyConfigurator::new;
        mic.setConfiguratorSupplier(supplier);

        assertSame(supplier, mic.getConfiguratorSupplier());

        // verify that the supplier actually creates a configurator instance
        GenericXMLConfigurator cfg = mic.getConfiguratorSupplier().get();
        assertNotNull(cfg);
        assertTrue(cfg instanceof DummyConfigurator);
    }

    // -----------------------------------------------------------------------
    // Additional edge cases
    // -----------------------------------------------------------------------

    @Test
    public void testPushNullObjectAndModel() {
        // The stacks accept null values; ensure they behave as expected.
        mic.pushObject(null);
        assertNull(mic.peekObject());
        assertNull(mic.popObject());

        mic.pushModel(null);
        assertNull(mic.peekModel());
        assertNull(mic.popModel());
    }

    @Test
    public void testMultipleDependencyDefinitionsSameDepender() {
        Model depender = new Model();
        mic.addDependencyDefinition(new DependencyDefinition(depender, "A"));
        mic.addDependencyDefinition(new DependencyDefinition(depender, "B"));
        mic.addDependencyDefinition(new DependencyDefinition(depender, "C"));

        List<String> depList = mic.getDependeeNamesForModel(depender);
        assertEquals(3, depList.size());
        assertTrue(depList.containsAll(Arrays.asList("A", "B", "C")));
    }

    @Test
    public void testCreateAppenderBagsDoesNotOverwriteExistingEntries() {
        mic.createAppenderBags();
        Map<String, Object> map = mic.getObjectMap();
        Map<String, Appender<?>> firstBag = (Map<String, Appender<?>>) map.get(JoranConstants.APPENDER_BAG);
        Map<String, AppenderAttachable<?>> firstRefBag = (Map<String, AppenderAttachable<?>>) map.get(JoranConstants.APPENDER_REF_BAG);

        // put dummy entries
        firstBag.put("myAppender", null);
        firstRefBag.put("myRef", null);

        // invoke again and ensure previous entries are still present
        mic.createAppenderBags();
        Map<String, Appender<?>> secondBag = (Map<String, Appender<?>>) map.get(JoranConstants.APPENDER_BAG);
        Map<String, AppenderAttachable<?>> secondRefBag = (Map<String, AppenderAttachable<?>>) map.get(JoranConstants.APPENDER_REF_BAG);

        assertTrue(secondBag.containsKey("myAppender"));
        assertTrue(secondRefBag.containsKey("myRef"));
    }
}
